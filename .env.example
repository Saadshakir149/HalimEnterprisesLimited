# Halim Accountants website: environment variables
#
# Copy this file to .env.local for local development and fill in real values.
# On Hostinger, set the same variables in hPanel (Websites → your Node.js app →
# Environment variables). Never commit real values: .env* files are gitignored,
# apart from this example.

# ---------------------------------------------------------------------------
# Email (contact forms)
#
# The forms send email through the business mailbox on the client's domain,
# using Nodemailer over SMTP (src/lib/email.ts).
#
# If any of SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, MAIL_FROM or MAIL_TO is
# missing:
#   - in development, nothing is sent and a redacted preview is logged instead;
#   - in production, the forms return 503 with a friendly message.
#
# Hostinger: the SMTP host and port are shown in hPanel → Emails → (your
# mailbox) → Connect apps and devices. At the time of writing these are usually
# smtp.hostinger.com with port 465 (SSL) or 587 (STARTTLS); check hPanel.
# ---------------------------------------------------------------------------

# SMTP server for the mailbox
SMTP_HOST=smtp.hostinger.com

# 465 for SSL/TLS, or 587 for STARTTLS
SMTP_PORT=465

# "true" for port 465 (implicit TLS), "false" for 587 (STARTTLS).
# Optional: if left out, it is worked out from the port.
SMTP_SECURE=true

# The full mailbox address and its password (the mailbox's own password, not your hPanel login)
SMTP_USER=
SMTP_PASS=

# Who the emails come from. Use the same mailbox as SMTP_USER so SPF/DKIM pass,
# e.g. "Halim Accountants <hello@halimaccountants.co.uk>"
MAIL_FROM=

# Where new enquiries and callback requests are delivered (the business inbox)
MAIL_TO=

# ---------------------------------------------------------------------------
# Site URL
# ---------------------------------------------------------------------------

# The confirmed production URL. Set it only once the domain is bought and live:
# it turns on canonical links, og:url, the sitemap, absolute URLs in structured
# data and the website address in emails. While it is unset none of those are
# produced (rather than pointing at a provisional domain), and the forms' Origin
# check falls back to the provisional domain in site.ts plus FORM_ALLOWED_ORIGINS.
# This is read at build time: rebuild after changing it.
# NEXT_PUBLIC_SITE_URL=https://www.example.co.uk

# Extra origins allowed to post to the forms in production, comma-separated.
# Useful while testing on a Hostinger temporary domain before DNS is connected.
# FORM_ALLOWED_ORIGINS=https://example-temporary.hostingersite.com
